{
  "$schema": "https://usemakoto.dev/schema/v0.2/profile-dialect.schema.json",
  "$id": "https://schemas.example.internal/makoto/public-transform-metadata-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "event", "operation", "inputs", "extensions"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "event": {
      "type": "object",
      "required": ["id", "occurredAt"]
    },
    "operation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "urn:makoto:demo:operation:public-safe" }
      }
    },
    "inputs": { "type": "array", "minItems": 1 },
    "extensions": {
      "type": "object",
      "required": ["urn:makoto:demo:privacy-reviewed"],
      "properties": {
        "urn:makoto:demo:privacy-reviewed": { "const": true }
      }
    }
  }
}
